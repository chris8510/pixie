{
  "name": "pixie-pet",
  "productName": "Pixie",
  "version": "0.4.1",
  "description": "A tiny desktop pet that shows what Claude Code is doing – compatible with Codex pets.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "keywords": [
    "claude-code",
    "desktop-pet",
    "codex-pets",
    "electron",
    "overlay",
    "whisper"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/install-hooks.js --uninstall",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always",
    "build-pets": "node skills/pixie-pet/scripts/build-pet.js tools/pixelchen.js pets/pixelchen && node skills/pixie-pet/scripts/build-pet.js skills/pixie-pet/examples/pricklet.js pets/pricklet && node tools/build-icon.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.0"
  },
  "devDependencies": {
    "electron": ">=38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.pixie-pet.pixie",
    "productName": "Pixie",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "config.default.json",
      "src/**",
      "renderer/**",
      "pets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Pixie uses the microphone for voice input. Audio is transcribed locally on your Mac and never uploaded."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ]
  }
}
